# ============================================================================
# VetLedger AI — Environment Configuration Template
# Copy this file to .env or export variables in your terminal
# ============================================================================

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vetledger_ai
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Optional AI Configuration (Google Gemini)
# Leave blank to automatically use the robust Deterministic Clinical Engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Mobile API Configuration (Flutter)
# Android Emulator: http://10.0.2.2:8080/api
# Desktop / Web: http://localhost:8080/api
# Physical Device: http://<YOUR_LAN_IP>:8080/api
API_URL=http://localhost:8080/api
